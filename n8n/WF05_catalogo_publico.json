    {
      "parameters": {
        "jsCode": "const datos = $input.all();\n\nconst eventos = datos\n  .map(item => item.json)\n  .filter(item => item.evento_id && item.nombre);\n\nconst inscripciones = datos\n  .map(item => item.json)\n  .filter(item => item.inscripcion_id && item.usuario_id);\n\nconst consulta = $('WF05 - Catálogo público').first().json;\nconst query = consulta.query || {};\n\nconst evento_id = String(query.evento_id || '').trim();\nconst categoria = String(query.categoria || '').trim().toLowerCase();\n\nlet resultado = [];\n\nfor (const evento of eventos) {\n  if (String(evento.estado || '').toUpperCase() !== 'PUBLICADO') {\n    continue;\n  }\n\n  if (evento_id && String(evento.evento_id) !== evento_id) {\n    continue;\n  }\n\n  if (\n    categoria &&\n    String(evento.categoria || '').toLowerCase() !== categoria\n  ) {\n    continue;\n  }\n\n  const confirmadas = inscripciones.filter(inscripcion =>\n    String(inscripcion.evento_id) === String(evento.evento_id) &&\n    String(inscripcion.estado || '').toUpperCase() === 'CONFIRMADA'\n  ).length;\n\n  const capacidad = Number(evento.capacidad || 0);\n  const disponibles = Math.max(capacidad - confirmadas, 0);\n\n  resultado.push({\n    json: {\n      ...evento,\n      cupos_confirmados: confirmadas,\n      cupos_disponibles: disponibles\n    }\n  });\n}\n\nreturn resultado;"
      },
