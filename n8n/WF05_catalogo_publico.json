    {
      "parameters": {
        "jsCode": "const eventos = $input.all();\n\nconst consulta = $('WF05 - Catálogo público').first().json;\nconst query = consulta.query || {};\n\nconst evento_id = String(query.evento_id || '').trim();\nconst categoria = String(query.categoria || '').trim();\n\nlet tipo = 'LISTADO';\n\nif (evento_id) {\n  tipo = 'DETALLE';\n} else if (categoria) {\n  tipo = 'FILTRO';\n}\n\nconst resultado_count = eventos.length;\n\nconst consulta_id =\n  'CON-' +\n  Date.now() +\n  '-' +\n  Math.random().toString(36).substring(2, 8);\n\nreturn [{\n  json: {\n    consulta_id,\n    fecha: new Date().toISOString(),\n    tipo,\n    evento_id,\n    categoria,\n    resultado_count,\n    visitor_id: '',\n    status_http: 200\n  }\n}];"
      },
