      "parameters": {
        "jsCode": "const usuario_id = $('WF03 - Validar solicitud').first().json.usuario_id;\n\n// Código de 6 caracteres sin letras ambiguas (sin 0, O, 1, I)\nconst alfabeto = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet codigo = '';\nfor (let i = 0; i < 6; i++) {\n  codigo += alfabeto[Math.floor(Math.random() * alfabeto.length)];\n}\n\nconst codigo_id = 'COD-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);\nconst creado_en = new Date();\nconst expira_en = new Date(creado_en.getTime() + 10 * 60 * 1000);\n\nreturn [{\n  json: {\n    codigo_id,\n    usuario_id,\n    codigo,\n    creado_en: creado_en.toISOString(),\n    expira_en: expira_en.toISOString(),\n    estado: 'PENDIENTE',\n    usado_en: ''\n  }\n}];"
      },
