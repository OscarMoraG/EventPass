    {
      "parameters": {
        "jsCode": "const m = $input.first().json.message || {};\nconst texto = String(m.text || '').trim();\nconst chat_id = m.chat ? m.chat.id : null;\nconst username = (m.from && (m.from.username || m.from.first_name)) || '';\n\nlet tipo = 'OTRO';\nlet codigo = '';\n\nconst vincular = texto.match(/^\\/vincular(?:@\\w+)?\\s+([A-Za-z0-9]+)\\s*$/i);\n\nif (vincular) {\n  tipo = 'VINCULAR';\n  codigo = vincular[1].toUpperCase();\n} else if (/^\\/vincular/i.test(texto)) {\n  tipo = 'VINCULAR_SIN_CODIGO';\n} else if (/^\\/start/i.test(texto)) {\n  tipo = 'START';\n}\n\nreturn [{ json: { tipo, codigo, chat_id, username, texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        600
      ],
      "id": "f3000000-0000-4000-8000-000000000011",
