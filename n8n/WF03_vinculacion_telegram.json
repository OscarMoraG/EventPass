    {
      "parameters": {
        "jsCode": "// Datos recibidos desde el Webhook\nconst body = $input.first().json.body;\n\n// Usuario que solicita la vinculación\nconst usuario_id = String(body.usuario_id || '').trim();\n\nif (!usuario_id) {\n  throw new Error('usuario_id es obligatorio');\n}\n\n// Generar código temporal de 6 caracteres\nconst codigo =\n  Math.random().toString(36).substring(2, 8).toUpperCase();\n\n// Identificador del código\nconst codigo_id =\n  'COD-' +\n  Date.now() +\n  '-' +\n  Math.random().toString(36).substring(2, 8);\n\n// Fechas\nconst creado_en = new Date();\n\nconst expira_en = new Date(\n  creado_en.getTime() + 10 * 60 * 1000\n);\n\nreturn [\n  {\n    json: {\n      codigo_id,\n      usuario_id,\n      codigo,\n      creado_en: creado_en.toISOString(),\n      expira_en: expira_en.toISOString(),\n      estado: 'PENDIENTE',\n      usado_en: ''\n    }\n  }\n];"
      },
