      "parameters": {
        "jsCode": "const msg = $('WF03 - Interpretar mensaje').first().json;\nconst filas = $input.all().map(i => i.json).filter(f => f.codigo_id);\nconst ahora = Date.now();\n\nconst fila = filas.find(f =>\n  String(f.estado || '').toUpperCase() === 'PENDIENTE' &&\n  new Date(f.expira_en).getTime() > ahora\n);\n\nif (!fila) {\n  const usado = filas.find(f => String(f.estado || '').toUpperCase() === 'USADO');\n  const vencido = filas.find(f => new Date(f.expira_en).getTime() <= ahora);\n\n  let texto = 'No encontré ese código. Revisa que esté bien escrito.';\n  if (usado) texto = 'Ese código ya fue utilizado. Genera uno nuevo desde EventPass.';\n  else if (vencido) texto = 'Ese código venció. Genera uno nuevo desde EventPass.';\n\n  return [{ json: { valido: false, chat_id: msg.chat_id, texto } }];\n}\n\nreturn [{\n  json: {\n    valido: true,\n    chat_id: msg.chat_id,\n    username: msg.username,\n    codigo_id: fila.codigo_id,\n    usuario_id: fila.usuario_id,\n    vinculacion_id: 'VIN-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8),\n    fecha: new Date().toISOString()\n  }\n}];"
