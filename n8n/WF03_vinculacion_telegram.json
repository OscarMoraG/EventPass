    {
      "parameters": {
        "jsCode": "const m = $('WF03 - Interpretar mensaje').first().json;\n\nlet texto;\nif (m.tipo === 'VINCULAR_SIN_CODIGO') {\n  texto = 'Escribe /vincular seguido de tu código. Ejemplo: /vincular ABC123';\n} else if (m.tipo === 'START') {\n  texto = '¡Hola! Soy el bot de EventPass. Para vincular tu cuenta, genera un código en la página de EventPass y escribe aquí: /vincular CODIGO';\n} else {\n  texto = 'No entendí ese mensaje. Para vincular tu cuenta escribe: /vincular CODIGO';\n}\n\nreturn [{ json: { chat_id: m.chat_id, texto } }];"
      },
