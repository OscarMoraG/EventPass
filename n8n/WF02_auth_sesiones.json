      "parameters": {
        "jsCode": "const usuario = $input.first().json;\nconst login = $('WF02 - Validar solicitud').first().json;\n\nconst fallo = mensaje => [{ json: { valido: false, mensaje } }];\n\nif (!usuario.usuario_id) {\n  return fallo('Correo o contraseña incorrectos.');\n}\n\nif (String(usuario.estado || '').trim().toUpperCase() !== 'ACTIVO') {\n  return fallo('Tu cuenta está inactiva.');\n}\n\nreturn [{\n  json: {\n    valido: true,\n    usuario_id: usuario.usuario_id,\n    nombre: usuario.nombre,\n    email_normalizado: usuario.email_normalizado,\n    password_para_hash: String(login.password) + String(usuario.password_salt),\n    password_hash_esperado: usuario.password_hash,\n    estado: usuario.estado\n  }\n}];"
      },
