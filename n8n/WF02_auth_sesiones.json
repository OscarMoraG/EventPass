    {
      "parameters": {
        "jsCode": "// Usuario encontrado en Google Sheets\nconst usuario = $input.first().json;\n\n// Datos enviados por el login\nconst login = $('WF02_sesiones').first().json.body;\n\n// Verificar que exista el usuario\nif (!usuario.usuario_id) {\n  throw new Error('Usuario no encontrado');\n}\n\n// Verificar que el usuario esté activo\nif (usuario.estado !== 'ACTIVO') {\n  throw new Error('El usuario está INACTIVO');\n}\n\n// Verificar que se haya enviado contraseña\nif (!login.password) {\n  throw new Error('La contraseña es obligatoria');\n}\n\n// Preparar la contraseña para calcular su hash\nconst passwordParaHash =\n  String(login.password) + String(usuario.password_salt);\n\n// Devolver los datos necesarios\nreturn [\n  {\n    json: {\n      usuario_id: usuario.usuario_id,\n      email_normalizado: usuario.email_normalizado,\n      password_para_hash: passwordParaHash,\n      password_hash_esperado: usuario.password_hash,\n      password_salt: usuario.password_salt,\n      estado: usuario.estado\n    }\n  }\n];"
      },
