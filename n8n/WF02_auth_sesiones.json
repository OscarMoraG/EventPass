        "jsCode": "const body = $input.first().json.body || {};\n\nconst email = String(body.email || '').trim().toLowerCase();\nconst password = String(body.password || '');\n\nif (!email || !password) {\n  return [{ json: { valido: false, mensaje: 'El correo y la contraseña son obligatorios.' } }];\n}\n\nreturn [{ json: { valido: true, email, password } }];"
      },
