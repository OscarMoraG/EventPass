    {
      "parameters": {
        "jsCode": "const r = $('WF09 - Resolver destinos').first().json;\nconst g = $('Send a message').first().json || {};\nconst t = $('WF09 - Enviar Telegram').first().json || {};\n\nconst texto = e => e\n  ? String(typeof e === 'string' ? e : (e.message || JSON.stringify(e))).slice(0, 300)\n  : '';\n\nlet gmail_estado, gmail_error = '';\nif (!r.email) {\n  gmail_estado = 'NO_APLICA';\n  gmail_error = 'El usuario no tiene correo registrado.';\n} else if (g.error) {\n  gmail_estado = 'ERROR';\n  gmail_error = texto(g.error);\n} else {\n  gmail_estado = 'ENVIADO';\n}\n\nlet telegram_estado, telegram_error = '';\nif (!r.chat_id) {\n  telegram_estado = 'NO_APLICA';\n  telegram_error = 'El usuario no tiene Telegram vinculado.';\n} else if (t.error) {\n  telegram_estado = 'ERROR';\n  telegram_error = texto(t.error);\n} else {\n  telegram_estado = 'ENVIADO';\n}\n\nreturn [{\n  json: {\n    notificacion_id: r.notificacion_id,\n    gmail_estado,\n    gmail_error,\n    telegram_estado,\n    telegram_error\n  }\n}];"
      },
