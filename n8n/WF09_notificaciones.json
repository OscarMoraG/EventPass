    {
      "parameters": {
        "jsCode": "const base = $('WF09 - Preparar notificación').first().json;\n\nconst usuario = $('WF09 - Consultar usuario').all()\n  .map(i => i.json)\n  .find(u => u.usuario_id) || {};\n\n// Última vinculación ACTIVA de Telegram\nconst vinculacion = $('WF09 - Consultar vinculación').all()\n  .map(i => i.json)\n  .filter(v => v.chat_id && String(v.estado || '').toUpperCase() === 'ACTIVA')\n  .sort((a, b) => new Date(b.fecha_vinculacion || 0) - new Date(a.fecha_vinculacion || 0))[0];\n\nreturn [{\n  json: {\n    ...base,\n    email: usuario.email_normalizado || '',\n    chat_id: vinculacion ? String(vinculacion.chat_id) : ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
