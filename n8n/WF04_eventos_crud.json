    {
      "parameters": {
        "jsCode": "// Datos enviados por el formulario\nconst datos = $input.first().json;\n\n// Generar identificador único del evento\nconst evento_id =\n  'EVT-' +\n  Date.now() +\n  '-' +\n  Math.random().toString(36).substring(2, 8);\n\n// Fechas de control\nconst ahora = new Date();\n\nreturn [\n  {\n    json: {\n      evento_id,\n\n      nombre: datos['Nombre del evento'] || '',\n      categoria: datos['Categoría'] || '',\n      descripcion: datos['Descripción del evento'] || '',\n      fecha: datos['Fecha del evento'] || '',\n      hora: datos['Hora del evento'] || '',\n      lugar: datos['Lugar del evento'] || '',\n      capacidad: datos['Capacidad'] || '',\n      imagen_url: datos['URL de imagen'] || '',\n      organizador: datos['Organizador'] || '',\n\n      accion: datos['Acción'] || '',\n\n      estado: 'BORRADOR',\n\n      fecha_creacion: ahora.toISOString(),\n      fecha_actualizacion: ahora.toISOString()\n    }\n  }\n];"
      },
