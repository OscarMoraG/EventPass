{
  "name": "WF01_usuarios_crud",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Obtener los datos enviados por el Webhook\nconst body = $input.first().json.body;\n\n// Verificar que exista información\nif (!body) {\n  throw new Error('No se recibieron datos');\n}\n\n// Obtener y normalizar los datos\nconst accion = String(body.accion || '').trim().toLowerCase();\nconst nombre = String(body.nombre || '').trim();\nconst email = String(body.email || '').trim().toLowerCase();\nconst password = String(body.password || '');\n\n// Acciones permitidas\nconst accionesPermitidas = [\n  'crear',\n  'consultar',\n  'actualizar',\n  'desactivar'\n];\n\n// Validar acción\nif (!accionesPermitidas.includes(accion)) {\n  throw new Error(\n    'La acción debe ser: crear, consultar, actualizar o desactivar'\n  );\n}\n\n// Validar nombre\nif (['crear', 'actualizar'].includes(accion) && !nombre) {\n  throw new Error('El nombre es obligatorio');\n}\n\n// Validar email\nif (!email) {\n  throw new Error('El email es obligatorio');\n}\n\n// Validar formato básico del email\nif (!email.includes('@')) {\n  throw new Error('El email no tiene un formato válido');\n}\n\n// Validar contraseña para creación\nif (accion === 'crear' && password.length < 6) {\n  throw new Error('La contraseña debe tener mínimo 6 caracteres');\n}\n\n// Generar identificador solo cuando se crea un usuario\nconst usuario_id =\n  accion === 'crear'\n    ? 'USR-' +\n      Date.now() +\n      '-' +\n      Math.random().toString(36).substring(2, 8)\n    : String(body.usuario_id || '').trim();\n\n// Fecha actual\nconst fechaActual = new Date().toISOString();\n\n// Devolver información preparada\nreturn [\n  {\n    json: {\n      accion,\n      usuario_id,\n      nombre,\n      email_normalizado: email,\n      password,\n      estado: accion === 'desactivar' ? 'INACTIVO' : 'ACTIVO',\n      fecha_registro: fechaActual,\n      fecha_actualizacion: fechaActual,\n      validacion: 'OK'\n    }\n  }\n];"
      },
