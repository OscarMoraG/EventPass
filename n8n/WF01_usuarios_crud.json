{
  "name": "WF01_usuarios_crud",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\nconst fallo = mensaje => [{ json: { valido: false, mensaje } }];\n\nconst accion = String(body.accion || '').trim().toLowerCase();\nconst nombre = String(body.nombre || '').trim();\nconst email = String(body.email || '').trim().toLowerCase();\nconst password = String(body.password || '');\n\nconst accionesPermitidas = ['crear', 'consultar', 'actualizar', 'desactivar'];\n\nif (!accionesPermitidas.includes(accion)) {\n  return fallo('La acción debe ser: crear, consultar, actualizar o desactivar.');\n}\nif (['crear', 'actualizar'].includes(accion) && !nombre) {\n  return fallo('El nombre es obligatorio.');\n}\nif (!email) {\n  return fallo('El correo electrónico es obligatorio.');\n}\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n  return fallo('El correo electrónico no tiene un formato válido.');\n}\nif (accion === 'crear' && password.length < 6) {\n  return fallo('La contraseña debe tener mínimo 6 caracteres.');\n}\n\nconst usuario_id = accion === 'crear'\n  ? 'USR-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8)\n  : String(body.usuario_id || '').trim();\n\nconst fechaActual = new Date().toISOString();\n\nreturn [{\n  json: {\n    valido: true,\n    accion,\n    usuario_id,\n    nombre,\n    email_normalizado: email,\n    password,\n    estado: accion === 'desactivar' ? 'INACTIVO' : 'ACTIVO',\n    fecha_registro: fechaActual,\n    fecha_actualizacion: fechaActual\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -780,
