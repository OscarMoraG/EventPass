    {
      "parameters": {
        "jsCode": "const evento = $('WF06 - Consultar evento').first().json;\nconst nueva = $('WF06 - Preparar inscripción').first().json;\nconst inscripciones = $('WF06 - Todas las inscripciones').all();\n\nconst evento_id = nueva.evento_id;\nconst usuario_id = nueva.usuario_id;\n\n// Validar que el evento exista\nif (!evento.evento_id) {\n  throw new Error('El evento no existe');\n}\n\n// Validar que esté publicado\nif (String(evento.estado).toUpperCase() !== 'PUBLICADO') {\n  throw new Error('El evento no está disponible para inscripción');\n}\n\n// Capacidad\nconst capacidad = Number(evento.capacidad || 0);\n\nif (capacidad <= 0) {\n  throw new Error('El evento no tiene una capacidad válida');\n}\n\n// Inscripciones del mismo evento\nconst inscripcionesEvento = inscripciones.filter(item =>\n  String(item.json.evento_id || '') === evento_id\n);\n\n// Confirmadas\nconst confirmadas = inscripcionesEvento.filter(item =>\n  String(item.json.estado || '').toUpperCase() === 'CONFIRMADA'\n);\n\n// Lista de espera\nconst listaEspera = inscripcionesEvento.filter(item =>\n  String(item.json.estado || '').toUpperCase() === 'LISTA_ESPERA'\n);\n\n// Validar inscripción duplicada activa\nconst duplicada = inscripcionesEvento.find(item =>\n  String(item.json.usuario_id || '') === usuario_id &&\n  ['CONFIRMADA', 'LISTA_ESPERA'].includes(\n    String(item.json.estado || '').toUpperCase()\n  )\n);\n\nif (duplicada) {\n  throw new Error('El usuario ya tiene una inscripción activa en este evento');\n}\n\n// Determinar estado\nlet estado;\nlet orden_espera = '';\n\nif (confirmadas.length < capacidad) {\n  estado = 'CONFIRMADA';\n} else {\n  estado = 'LISTA_ESPERA';\n  orden_espera = listaEspera.length + 1;\n}\n\nreturn [\n  {\n    json: {\n      ...nueva,\n      estado,\n      orden_espera,\n      capacidad,\n      confirmadas_actuales: confirmadas.length,\n      cupos_disponibles: Math.max(capacidad - confirmadas.length, 0)\n    }\n  }\n];"
      },
