      "parameters": {
        "jsCode": "const datos = $input.first().json;\n\nconst estado = String(datos.estado || '').toUpperCase();\n\nlet tipo;\nlet titulo;\nlet mensaje;\n\nif (estado === 'CONFIRMADA') {\n  tipo = 'INSCRIPCION_CONFIRMADA';\n  titulo = 'Inscripción confirmada';\n  mensaje = 'Tu inscripción al evento fue confirmada correctamente.';\n} else if (estado === 'LISTA_ESPERA') {\n  tipo = 'LISTA_ESPERA';\n  titulo = 'Ingreso a lista de espera';\n  mensaje = 'El evento está lleno. Has sido agregado a la lista de espera.';\n} else {\n  tipo = 'INSCRIPCION';\n  titulo = 'Actualización de inscripción';\n  mensaje = 'Tu inscripción ha sido procesada.';\n}\n\nreturn [{\n  json: {\n    ...datos,\n    tipo,\n    titulo,\n    mensaje\n  }\n}];"
      },
