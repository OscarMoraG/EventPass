      "parameters": {
        "jsCode": "const inscripciones = $input.all();\n\nconst preparacion = $('WF06 - Preparar inscripción').first().json;\n\nconst usuario_id = String(preparacion.usuario_id || '').trim();\nconst evento_id = String(preparacion.evento_id || '').trim();\n\nconst inscripcionActiva = inscripciones.some(item => {\n  const data = item.json;\n\n  return (\n    String(data.usuario_id || '').trim() === usuario_id &&\n    String(data.evento_id || '').trim() === evento_id &&\n    ['CONFIRMADA', 'LISTA_ESPERA'].includes(\n      String(data.estado || '').toUpperCase()\n    )\n  );\n});\n\nreturn [{\n  json: {\n    ...preparacion,\n    inscripcion_activa: inscripcionActiva\n  }\n}];"
