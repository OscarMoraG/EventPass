      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\n\nconst usuario_id = String(body.usuario_id || '').trim();\nconst evento_id = String(body.evento_id || '').trim();\nconst sesion_id = String(body.sesion_id || '').trim();\n\nif (!usuario_id) {\n  throw new Error('usuario_id es obligatorio');\n}\n\nif (!evento_id) {\n  throw new Error('evento_id es obligatorio');\n}\n\nconst inscripcion_id =\n  'INS-' +\n  Date.now() +\n  '-' +\n  Math.random().toString(36).substring(2, 8);\n\nconst fecha = new Date().toISOString();\n\nreturn [{\n  json: {\n    inscripcion_id,\n    usuario_id,\n    evento_id,\n    sesion_id,\n    fecha_inscripcion: fecha,\n    fecha_actualizacion: fecha,\n    nombre_acreditacion: body.nombre_acreditacion || '',\n    observaciones: body.observaciones || '',\n    origen: body.origen || 'WEB',\n    orden_espera: ''\n  }\n}];"
