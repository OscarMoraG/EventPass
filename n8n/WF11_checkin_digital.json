      "id": "c61c5d73-83e3-4738-857e-0fa25772474b",
      "name": "WF11 - Consultar historial check-in",
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "F4XBiwGF1TKJqTHr",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst entrada = $('Webhook').first().json.body || {};\n\nconst inscripciones = $('WF11 - Consultar inscripción').all()\n  .map(item => item.json);\n\nconst eventos = $('WF11 - Consultar evento').all()\n  .map(item => item.json);\n\nconst historial = $('WF11 - Consultar historial check-in').all()\n  .map(item => item.json);\n\nconst inscripcion = inscripciones.find(\n  item => String(item.inscripcion_id) === String(entrada.inscripcion_id)\n);\n\nconst evento = eventos.find(\n  item => String(item.evento_id) === String(entrada.evento_id)\n);\n\nconst checkinPrevio = historial.find(\n  item =>\n    String(item.inscripcion_id) === String(entrada.inscripcion_id) &&\n    String(item.resultado || '').toUpperCase() === 'EXITOSO'\n);\n\nlet resultado = 'RECHAZADO';\nlet detalle = '';\n\nif (!entrada.inscripcion_id || !entrada.evento_id) {\n  detalle = 'Faltan inscripcion_id o evento_id.';\n} else if (!inscripcion) {\n  detalle = 'La inscripción no existe.';\n} else if (!evento) {\n  detalle = 'El evento no existe.';\n} else if (\n  String(inscripcion.evento_id) !== String(entrada.evento_id)\n) {\n  detalle = 'La inscripción no corresponde al evento enviado.';\n} else if (checkinPrevio) {\n  resultado = 'DUPLICADO';\n  detalle = 'El ingreso ya había sido registrado.';\n} else if (\n  String(inscripcion.estado || '').toUpperCase() !== 'CONFIRMADA'\n) {\n  detalle = `La inscripción no permite ingreso. Estado actual: ${inscripcion.estado || 'SIN ESTADO'}.`;\n} else {\n  resultado = 'EXITOSO';\n  detalle = 'Validaciones correctas. Check-in autorizado.';\n}\n\nreturn [{\n  json: {\n    inscripcion_id: entrada.inscripcion_id || '',\n    evento_id: entrada.evento_id || '',\n    usuario_id: inscripcion?.usuario_id || '',\n    checkin_id: 'CHK-' + Date.now() + '-' +\n      Math.random().toString(36).substring(2, 8),\n    fecha_checkin: new Date().toISOString(),\n    resultado,\n    detalle\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
