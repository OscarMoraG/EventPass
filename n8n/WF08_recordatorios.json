    {
      "parameters": {
        "jsCode": "const eventos = $('WF08 - Consultar eventos').all();\nconst inscripciones = $('WF08 - Consultar inscripciones').all();\nconst recordatorios = $('WF08 - Consultar recordatorios').all();\n\nconst ahora = new Date();\nconst resultado = [];\n\nfor (const eventoItem of eventos) {\n\n  const evento = eventoItem.json;\n\n  if (String(evento.estado).toUpperCase() !== 'PUBLICADO') {\n    continue;\n  }\n\n  if (!evento.evento_id || !evento.fecha || !evento.hora) {\n    continue;\n  }\n\n  const fechaEvento = new Date(\n    evento.fecha + 'T' + evento.hora + ':00-05:00'\n  );\n\n  if (isNaN(fechaEvento.getTime())) {\n    continue;\n  }\n\n  const diferenciaHoras =\n    (fechaEvento.getTime() - ahora.getTime()) / (1000 * 60 * 60);\n\n  // Evento dentro de las próximas 24 horas\n  if (diferenciaHoras <= 0 || diferenciaHoras > 24) {\n    continue;\n  }\n\n  for (const inscripcionItem of inscripciones) {\n\n    const inscripcion = inscripcionItem.json;\n\n    if (\n      String(inscripcion.evento_id) !== String(evento.evento_id)\n    ) {\n      continue;\n    }\n\n    if (\n      String(inscripcion.estado).toUpperCase() !== 'CONFIRMADA'\n    ) {\n      continue;\n    }\n\n    const clave =\n      inscripcion.usuario_id +\n      '_' +\n      evento.evento_id +\n      '_24H';\n\n    const duplicado = recordatorios.some(item => {\n      return String(item.json.clave_idempotencia || '') === clave;\n    });\n\n    if (duplicado) {\n      continue;\n    }\n\n    resultado.push({\n      json: {\n        recordatorio_id:\n          'REC-' +\n          Date.now() +\n          '-' +\n          Math.random().toString(36).substring(2, 8),\n\n        usuario_id: inscripcion.usuario_id,\n\n        evento_id: evento.evento_id,\n\n        inscripcion_id: inscripcion.inscripcion_id,\n\n        tipo_recordatorio: '24H',\n\n        fecha_programada:\n          new Date(\n            fechaEvento.getTime() - 24 * 60 * 60 * 1000\n          ).toISOString(),\n\n        fecha_envio: '',\n\n        estado: 'PENDIENTE',\n\n        clave_idempotencia: clave\n      }\n    });\n  }\n}\n\nreturn resultado;"
      },
