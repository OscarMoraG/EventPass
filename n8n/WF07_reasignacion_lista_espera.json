    {
      "parameters": {
        "jsCode": "const encontrado = $input.first().json;\nconst calculado = $('WF07 - Calcular reasignaciones').all()[$itemIndex].json;\n\nreturn [\n  {\n    json: {\n      ...encontrado,\n\n      reasignacion_id:\n        'REA-' +\n        Date.now() +\n        '-' +\n        Math.random().toString(36).substring(2, 8),\n\n      evento_id: calculado.evento_id,\n      inscripcion_id: calculado.inscripcion_id,\n      usuario_id: calculado.usuario_id,\n      fecha: calculado.fecha_reasignacion,\n      orden_lista: calculado.orden_lista,\n      estado_anterior: calculado.estado_anterior,\n      estado_nuevo: calculado.estado_nuevo,\n      resultado_notificacion: 'PENDIENTE'\n    }\n  }\n];"
