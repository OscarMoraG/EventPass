    {
      "parameters": {
        "jsCode": "const eventos = $('WF07 - Consultar eventos').all();\nconst inscripciones = $input.all();\n\nconst reasignaciones = [];\n\nfor (const eventoItem of eventos) {\n  const evento = eventoItem.json;\n\n  const eventoId = String(evento.evento_id || '');\n\n  if (!eventoId) {\n    continue;\n  }\n\n  // No reasignar eventos cancelados o cerrados\n  const estadoEvento = String(evento.estado || '').toUpperCase();\n\n  if (['CANCELADO', 'CERRADO'].includes(estadoEvento)) {\n    continue;\n  }\n\n  const capacidad = Number(evento.capacidad || 0);\n\n  // Inscripciones pertenecientes a este evento\n  const inscripcionesEvento = inscripciones.filter(item =>\n    String(item.json.evento_id || '') === eventoId\n  );\n\n  // Personas actualmente confirmadas\n  const confirmadas = inscripcionesEvento.filter(item =>\n    String(item.json.estado || '').toUpperCase() === 'CONFIRMADA'\n  );\n\n  // Personas en lista de espera\n  const espera = inscripcionesEvento\n    .filter(item =>\n      String(item.json.estado || '').toUpperCase() === 'LISTA_ESPERA'\n    )\n    .sort((a, b) => {\n      const fechaA = new Date(a.json.fecha_inscripcion || 0);\n      const fechaB = new Date(b.json.fecha_inscripcion || 0);\n\n      return fechaA - fechaB;\n    });\n\n  // Cupos disponibles\n  const cuposDisponibles = Math.max(\n    capacidad - confirmadas.length,\n    0\n  );\n\n  // Seleccionar únicamente los primeros usuarios de la lista\n  const candidatos = espera.slice(0, cuposDisponibles);\n\n  candidatos.forEach((item, index) => {\n    reasignaciones.push({\n      json: {\n        ...item.json,\n\n        estado_anterior: 'LISTA_ESPERA',\n        estado_nuevo: 'CONFIRMADA',\n\n        orden_lista: index + 1,\n\n        fecha_reasignacion: new Date().toISOString(),\n\n        evento_nombre: evento.nombre,\n\n        cupos_disponibles: cuposDisponibles\n      }\n    });\n  });\n}\n\nreturn reasignaciones;"
      },
