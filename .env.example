# ==========================================
# EventPass - Variables de entorno (ejemplo)
# ==========================================
# El frontend es estático y no lee un archivo .env:
# estas constantes se escriben en frontend/js/app.js y frontend/js/chat.js.
# Las credenciales reales se configuran DENTRO de n8n y NUNCA se suben al repositorio.

# --- Backend público (n8n expuesto con ngrok) ---
N8N_BASE_URL=https://hydrant-supermom-raging.ngrok-free.dev
WEBHOOK_URL=https://hydrant-supermom-raging.ngrok-free.dev/

# --- Webhooks ---
N8N_CATALOGO_WEBHOOK=/webhook/catalogo
N8N_USUARIOS_WEBHOOK=/webhook/usuarios
N8N_SESIONES_WEBHOOK=/webhook/sesiones
N8N_TELEGRAM_WEBHOOK=/webhook/telegram
N8N_INSCRIPCIONES_WEBHOOK=/webhook/inscripciones
N8N_CHECKIN_WEBHOOK=/webhook/checkin
N8N_CHAT_WEBHOOK=/webhook/<ID_DEL_CHAT_TRIGGER>/chat

# --- Frontend ---
FRONTEND_URL=https://eventpass-frontend-theta.vercel.app

# --- Telegram (solo el nombre público; el token va en la credencial de n8n) ---
TELEGRAM_BOT_USERNAME=EventPassMoraBot

# --- Credenciales: configurar en n8n, dejar vacías aquí ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
